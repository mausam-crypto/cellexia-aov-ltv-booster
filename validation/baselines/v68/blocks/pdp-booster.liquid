{%- if request.page_type == 'product' -%}
{%- assign cfg = app.metafields.cellexia.config.value -%}
{%- assign cx_market = localization.market.handle | default: '' -%}
{%- assign cx_prev = cfg.preview -%}
{%- assign cx_prev_armed = false -%}
{%- if cx_prev.armed == true -%}
{%- assign cx_prev_armed = true -%}
{%- endif -%}
{%- liquid
assign show_badges = false
if cfg.trustBadges.enabled == true and block.settings.show_badges
assign cx_scope = cfg.marketScopes.trust_badges
if cx_scope.mode != 'selected' or cx_scope.markets contains cx_market
assign show_badges = true
endif
endif
assign show_guarantee = false
if cfg.guarantee.enabled == true and block.settings.show_guarantee
assign cx_scope = cfg.marketScopes.guarantee
if cx_scope.mode != 'selected' or cx_scope.markets contains cx_market
assign show_guarantee = true
endif
endif
assign show_trustpilot = false
if cfg.trustpilot.enabled == true and block.settings.show_trustpilot
assign cx_scope = cfg.marketScopes.trustpilot
if cx_scope.mode != 'selected' or cx_scope.markets contains cx_market
assign show_trustpilot = true
endif
endif
assign show_nudge = false
if cfg.subscriptionNudge.enabled == true and block.settings.show_nudge
assign cx_scope = cfg.marketScopes.subscription_nudge
if cx_scope.mode != 'selected' or cx_scope.markets contains cx_market
assign show_nudge = true
endif
endif
if customer.b2b?
assign show_nudge = false
endif
assign cx_pdp_flags = product.metafields.cellexia.pdp_flags.value
assign survey_total = cfg.dermSurvey.sampleSize | default: 0
assign survey_yes = cfg.dermSurvey.yesCount | default: 0
assign survey_verifier = cfg.dermSurvey.verifierName
assign survey_url = cfg.dermSurvey.verificationUrl
assign survey_ok = false
if survey_yes > 0 and survey_total > 0 and survey_yes <= survey_total
assign survey_pct = survey_yes | times: 100.0 | divided_by: survey_total | round
assign survey_ok = true
endif
assign show_survey = false
if cfg.dermSurvey.enabled == true and block.settings.show_derm_survey and survey_ok
assign cx_scope = cfg.marketScopes.derm_survey
if cx_scope.mode != 'selected' or cx_scope.markets contains cx_market
if cx_pdp_flags.derm_survey != false
assign show_survey = true
endif
endif
endif
assign show_study = false
if cfg.clinicalStudy.enabled == true and block.settings.show_clinical_study
assign cx_scope = cfg.marketScopes.clinical_study
if cx_scope.mode != 'selected' or cx_scope.markets contains cx_market
if cx_pdp_flags.clinical_study != false
assign cx_study = product.metafields.cellexia.clinical_study.value
if cx_study
assign show_study = true
endif
endif
endif
endif
assign show_ba = false
assign cx_ba_count = 0
if cfg.beforeAfter.enabled == true and block.settings.show_before_after
assign cx_scope = cfg.marketScopes.verified_before_after
if cx_scope.mode != 'selected' or cx_scope.markets contains cx_market
if cx_pdp_flags.verified_before_after != false
assign cx_bas = product.metafields.cellexia.before_afters.value
assign cx_ba_count = cx_bas.size | default: 0
if cx_ba_count > 0
assign show_ba = true
endif
endif
endif
endif
assign show_batch = false
assign cx_batch_ing_count = 0
assign cx_batch_coa_count = 0
if cfg.batchTransparency.enabled == true and block.settings.show_batch
assign cx_scope = cfg.marketScopes.batch_transparency
if cx_scope.mode != 'selected' or cx_scope.markets contains cx_market
if cx_pdp_flags.batch_transparency != false
assign cx_batch = product.metafields.cellexia.batch_transparency.value
if cx_batch
assign cx_batch_ing_count = cx_batch.ingredients.value.size | default: 0
assign cx_batch_coa_count = cx_batch.certificates.value.size | default: 0
if cx_batch_ing_count > 0 or cx_batch_coa_count > 0
assign show_batch = true
endif
endif
endif
endif
endif
assign show_bottle = false
if cfg.emptyBottleGuarantee.enabled == true and block.settings.show_bottle
assign cx_scope = cfg.marketScopes.empty_bottle_guarantee
if cx_scope.mode != 'selected' or cx_scope.markets contains cx_market
if cx_pdp_flags.empty_bottle_guarantee != false
assign show_bottle = true
endif
endif
endif
assign cx_country = localization.country.iso_code | upcase
assign cx_dsp = cfg.dispatch.byCountry[cx_country]
assign cx_dsp_cutoff = cfg.dispatch.cutoff | default: '14:00'
assign cx_dsp_tz = cfg.dispatch.timezone | default: 'Europe/Paris'
assign cx_dsp_days = cfg.dispatch.days
assign cx_dsp_within = cfg.dispatch.showWithinHours | default: 8
if cx_dsp
assign cx_dsp_cutoff = cx_dsp.cutoff
assign cx_dsp_tz = cx_dsp.timezone
assign cx_dsp_days = cx_dsp.days
endif
assign show_dispatch = false
if cfg.dispatch.enabled == true
unless cfg.dispatch.showOnPdp == false
assign cx_scope = cfg.marketScopes.dispatch_countdown
if cx_scope.mode != 'selected' or cx_scope.markets contains cx_market
assign show_dispatch = true
endif
endunless
endif
assign cx_de = cfg.deliveryEstimate
assign cx_del_c = cx_de.byCountry[cx_country]
assign cx_del_hidden = false
if cx_del_c.hidden == true
assign cx_del_hidden = true
endif
assign show_delivery = false
if cx_de.enabled == true and cx_de.showOnPdp != false and cx_del_hidden == false
assign cx_scope = cfg.marketScopes.delivery_estimate
if cx_scope.mode != 'selected' or cx_scope.markets contains cx_market
assign show_delivery = true
endif
endif
assign threshold = cfg.global.freeShippingThreshold | default: 150
assign threshold_money = threshold | times: 100 | money
assign cx_fs = cfg.freeShipping.byMarket[cx_market]
assign cx_fs_badge_ok = false
assign cx_fs_badge_money = threshold_money
if cx_fs and cx_fs.currencyCode == cart.currency.iso_code
assign cx_fs_badge_money = cx_fs.amount | times: 100 | round | money
assign cx_fs_badge_ok = true
elsif cart.currency.iso_code == shop.currency
assign cx_fs_badge_ok = true
endif
assign guarantee_days = cfg.guarantee.days | default: 60
assign tp_rating = cfg.trustpilot.rating | default: 4.8
assign tp_rating_rounded = tp_rating | round: 1
assign tp_sep = 'trustpilot.decimal_separator' | t
assign tp_count = cfg.trustpilot.reviewCount | default: 1000
assign tp_url = cfg.trustpilot.profileUrl | default: 'https://www.trustpilot.com/review/cellexia.com'
assign nudge_pct = cfg.subscriptionNudge.discountPct | default: 5
assign bottle_days = cfg.emptyBottleGuarantee.days | default: 60
assign cx_draft_badges = false
assign cx_draft_guarantee = false
assign cx_draft_trustpilot = false
assign cx_draft_nudge = false
assign cx_draft_survey = false
assign cx_draft_study = false
assign cx_draft_ba = false
assign cx_draft_batch = false
assign cx_draft_bottle = false
assign cx_draft_dispatch = false
assign cx_draft_delivery = false
if cx_prev_armed
assign cx_prev_flags = cx_prev.draftFlags
if block.settings.show_badges
if cx_prev_flags.trust_badges == true or cfg.trustBadges.enabled == true
assign cx_draft_badges = true
endif
endif
if block.settings.show_guarantee
if cx_prev_flags.guarantee == true or cfg.guarantee.enabled == true
assign cx_draft_guarantee = true
endif
endif
if block.settings.show_trustpilot
if cx_prev_flags.trustpilot == true or cfg.trustpilot.enabled == true
assign cx_draft_trustpilot = true
endif
endif
if block.settings.show_nudge
if cx_prev_flags.subscription_nudge == true or cfg.subscriptionNudge.enabled == true
assign cx_draft_nudge = true
endif
endif
if customer.b2b?
assign cx_draft_nudge = false
endif
if block.settings.show_derm_survey and cx_pdp_flags.derm_survey != false and survey_ok
if cx_prev_flags.derm_survey == true or cfg.dermSurvey.enabled == true
assign cx_draft_survey = true
endif
endif
if block.settings.show_clinical_study and cx_pdp_flags.clinical_study != false
if cx_prev_flags.clinical_study == true or cfg.clinicalStudy.enabled == true
unless cx_study
assign cx_study = product.metafields.cellexia.clinical_study.value
endunless
if cx_study
assign cx_draft_study = true
endif
endif
endif
if block.settings.show_before_after and cx_pdp_flags.verified_before_after != false
if cx_prev_flags.verified_before_after == true or cfg.beforeAfter.enabled == true
unless cx_bas
assign cx_bas = product.metafields.cellexia.before_afters.value
assign cx_ba_count = cx_bas.size | default: 0
endunless
if cx_ba_count > 0
assign cx_draft_ba = true
endif
endif
endif
if block.settings.show_batch and cx_pdp_flags.batch_transparency != false
if cx_prev_flags.batch_transparency == true or cfg.batchTransparency.enabled == true
unless cx_batch
assign cx_batch = product.metafields.cellexia.batch_transparency.value
if cx_batch
assign cx_batch_ing_count = cx_batch.ingredients.value.size | default: 0
assign cx_batch_coa_count = cx_batch.certificates.value.size | default: 0
endif
endunless
if cx_batch_ing_count > 0 or cx_batch_coa_count > 0
assign cx_draft_batch = true
endif
endif
endif
if block.settings.show_bottle and cx_pdp_flags.empty_bottle_guarantee != false
if cx_prev_flags.empty_bottle_guarantee == true or cfg.emptyBottleGuarantee.enabled == true
assign cx_draft_bottle = true
endif
endif
unless cfg.dispatch.showOnPdp == false
if cx_prev_flags.dispatch_countdown == true or cfg.dispatch.enabled == true
assign cx_draft_dispatch = true
endif
endunless
if cx_de.showOnPdp != false and cx_del_hidden == false
if cx_prev_flags.delivery_estimate == true or cx_de.enabled == true
assign cx_draft_delivery = true
endif
endif
endif
assign cx_draft_any = false
if cx_draft_badges or cx_draft_guarantee or cx_draft_trustpilot or cx_draft_nudge or cx_draft_survey or cx_draft_study or cx_draft_ba or cx_draft_batch or cx_draft_bottle or cx_draft_dispatch or cx_draft_delivery
assign cx_draft_any = true
endif
-%}
{%- if show_badges or show_guarantee or show_trustpilot or show_nudge or show_survey or show_study or show_ba or show_batch or show_bottle or show_dispatch or show_delivery or cx_draft_any -%}
{{ 'cellexia-booster.css' | asset_url | stylesheet_tag }}
<script type="application/json" id="cx-pdp-config" data-cx-market="{{ cx_market | escape }}">
{
"b2b": {% if customer.b2b? %}true{% else %}false{% endif %},
"currency": {{ cart.currency.iso_code | json }},
{%- if show_dispatch or cx_draft_dispatch %}
"dispatch": {"live": {{ show_dispatch }}, "cutoff": {{ cx_dsp_cutoff | json }}, "timezone": {{ cx_dsp_tz | json }}, "days": {{ cx_dsp_days | json }}, "showWithinHours": {{ cx_dsp_within }}},
"strings": {"dispatch.within": {{ 'dispatch.within' | t: hours: '@@HOURS@@', minutes: '@@MINUTES@@' | json }}, "dispatch.within_minutes": {{ 'dispatch.within_minutes' | t: minutes: '@@MINUTES@@' | json }}},
{%- endif %}
{%- if show_delivery or cx_draft_delivery %}
"delivery": {"live": {{ show_delivery }}, "format": {{ cx_de.format | json }}, "pageLocale": {{ request.locale.iso_code | json }}, "minDays": {{ cx_de.minDays | json }}, "maxDays": {{ cx_de.maxDays | json }}, "deliveryDays": {{ cx_de.deliveryDays | json }}, "holidaysEnabled": {{ cx_de.holidaysEnabled | json }}, "country": {{ cx_country | json }}, "override": {{ cx_del_c | json }}, "schedule": {"cutoff": {{ cx_dsp_cutoff | json }}, "timezone": {{ cx_dsp_tz | json }}, "days": {{ cx_dsp_days | json }}}},
"deliveryStrings": {"delivery.line": {{ 'delivery.line' | t: date: '@@DATE@@' | json }}, "delivery.range": {{ 'delivery.range' | t: from: '@@FROM@@', to: '@@TO@@' | json }}, "delivery.range_same": {{ 'delivery.range_same' | t: date: '@@DATE@@' | json }}, "delivery.timeline_ship": {{ 'delivery.timeline_ship' | t: date: '@@DATE@@' | json }}, "delivery.timeline_delivered": {{ 'delivery.timeline_delivered' | t: date: '@@DATE@@' | json }}, "delivery.box_title": {{ 'delivery.box_title' | t: date: '@@DATE@@' | json }}, "delivery.tooltip": {{ 'delivery.tooltip' | t: date: '@@DATE@@' | json }}, "delivery.badge": {{ 'delivery.badge' | t | json }}, "delivery.timeline_order": {{ 'delivery.timeline_order' | t | json }}, "delivery.box_sub": {{ 'delivery.box_sub' | t | json }}},
{%- endif %}
{%- if show_survey or cx_draft_survey %}
"survey": {"live": {{ show_survey }}, "fmt": {{ cfg.dermSurvey.format | json }}, "pct": {{ survey_pct }}, "yes": {{ survey_yes }}, "total": {{ survey_total }}, "arc": {{ survey_pct | times: 2.8274 | round: 2 }}, "method": {{ cfg.dermSurvey.methodology | json }}, "verifier": {{ survey_verifier | default: '' | json }}, "url": {{ survey_url | default: '' | json }}},
"surveyStrings": {"eyebrow": {{ 'survey.eyebrow' | t | json }}, "title_pct": {{ 'survey.title_pct' | t | json }}, "count": {{ 'survey.count' | t: yes: survey_yes, total: survey_total | json }}, "how": {{ 'survey.how' | t | json }}, "verified_badge": {{ 'survey.verified_badge' | t | json }}, "verified_by": {{ 'survey.verified_by' | t: name: survey_verifier | json }}, "p1": {{ 'survey.methodology_p1' | t: total: survey_total | json }}, "p2": {{ 'survey.methodology_p2' | t | json }}, "p3": {{ 'survey.methodology_p3' | t | json }}, "p4": {{ 'survey.methodology_p4' | t: total: survey_total, yes: survey_yes, percent: survey_pct | json }}, "p5": {{ 'survey.methodology_p5' | t | json }}, "report_title": {{ 'survey.report_title' | t | json }}, "report_surveyed": {{ 'survey.report_surveyed' | t | json }}, "report_yes": {{ 'survey.report_yes' | t | json }}, "report_recommend": {{ 'survey.report_recommend' | t | json }}, "question_intro": {{ 'survey.question_intro' | t: total: survey_total | json }}, "question_result": {{ 'survey.question_result' | t: yes: survey_yes, percent: survey_pct | json }}, "dot_legend": {{ 'survey.dot_legend' | t | json }}},
{%- endif %}
{%- if show_badges or cx_draft_badges %}
{%- liquid
if cfg.trustBadges.items
assign badge_keys = cfg.trustBadges.items
else
assign badge_keys = 'secure_checkout,free_shipping_over,money_back,clinically_proven' | split: ','
endif
-%}
"badges": {"live": {{ show_badges }}, "k": {{ badge_keys | json }}, "fs": {{ cx_fs_badge_ok }}, "l": [{{ 'badges.secure_checkout' | t | json }}, {{ 'badges.free_shipping_over' | t: amount: cx_fs_badge_money | json }}, {{ 'badges.money_back' | t: days: guarantee_days | json }}, {{ 'badges.dermatologist_tested' | t | json }}, {{ 'badges.cruelty_free' | t | json }}, {{ 'badges.clinically_proven' | t | json }}, {{ 'badges.ssl_encrypted' | t | json }}, {{ 'badges.easy_returns' | t | json }}]},
{%- endif %}
{%- if show_guarantee or cx_draft_guarantee %}
"g": {"live": {{ show_guarantee }}, "t": {{ 'guarantee.title' | t: days: guarantee_days | json }}},
{%- endif %}
{%- if show_trustpilot or cx_draft_trustpilot %}
{%- liquid
assign tp_stars = tp_rating | times: 1.0
if tp_stars > 5
assign tp_stars = 5.0
endif
if tp_stars < 0
assign tp_stars = 0.0
endif
assign tp_stars_label = tp_stars | round: 1
-%}
"tp": {"live": {{ show_trustpilot }}, "aria": {{ 'a11y.rating_out_of_5' | t: rating: tp_stars_label | json }}, "label": {{ tp_rating_rounded | append: '' | replace: '.', tp_sep | append: '/5' | json }}, "r": {{ tp_stars | json }}, "cnt": {{ 'trustpilot.reviews_count' | t: count: tp_count | json }}, "view": {{ 'trustpilot.view' | t | json }}, "url": {{ tp_url | json }}, "link": {% if cfg.trustpilot.showLink == false %}false{% else %}true{% endif %}},
{%- endif %}
{%- if show_nudge or cx_draft_nudge %}
"n": {"live": {{ show_nudge }}, "t": {{ 'subscription.nudge_title' | t | json }}, "b": {{ 'subscription.nudge_body' | t: percent: nudge_pct | json }}},
{%- endif %}
"placement": {{ block.settings.proof_placement | default: 'above_tabs' | json }}
{%- if cx_prev_armed -%}
, "preview": {"armed": true, "flags": {% if cx_prev.draftFlags %}{{ cx_prev.draftFlags | json }}{% else %}{}{% endif %}, "deliveryFormat": {{ cx_prev.draftConfig.deliveryFormat | json }}, "surveyFormat": {{ cx_prev.draftConfig.dermSurveyFormat | json }}}
{%- endif %}
}
</script>
{%- if show_study or cx_draft_study -%}
<script type="application/json" id="cx-study-config">
{"live": {{ show_study }}, "t": {{ cx_study.title.value | json }}, "c": {{ cx_study.concern.value | json }}, "u": {{ cx_study.study_url.value | json }}, "r": [
{%- for cx_res in cx_study.results.value -%}
{%- unless forloop.first -%},{%- endunless -%}
{"v": {{ cx_res.value.value | json }}, "s": {{ cx_res.suffix.value | json }}, "l": {{ cx_res.label.value | json }}}
{%- endfor -%}
]
{%- liquid
assign cx_study_n = cx_study.sample_size.value
assign cx_study_weeks = cx_study.duration_weeks.value
assign cx_study_lab = cx_study.lab_name.value
-%}
{%- if cx_study_n != blank and cx_study_weeks != blank and cx_study_lab != blank -%}
{%- assign cx_weeks_label = 'study.weeks_count' | t: count: cx_study_weeks -%}
, "m1": {{ 'study.methodology' | t: n: cx_study_n, weeks: cx_weeks_label, lab: cx_study_lab | json }}
{%- endif -%}
{%- if cx_study.instruments.value != blank -%}
, "m2": {{ 'study.instruments' | t: methods: cx_study.instruments.value | json }}
{%- endif -%}
{%- if cx_study.footnote.value != blank -%}
, "f": {{ cx_study.footnote.value | json }}
{%- endif -%}
, "str": {"eyebrow": {{ 'study.eyebrow' | t | json }}, "view": {{ 'study.view_study' | t | json }}, "foot": {{ 'study.footnote_default' | t | json }}}}
</script>
{%- endif -%}
{%- if show_ba or cx_draft_ba -%}
<script type="application/json" id="cx-ba-config">
{"live": {{ show_ba }}, "pt": {{ product.title | json }}, "s": {"eyebrow": {{ 'ba.eyebrow' | t | json }}, "title": {{ 'ba.title' | t | json }}, "before": {{ 'ba.before' | t | json }}, "after": {{ 'ba.after' | t | json }}, "w0": {{ 'ba.week_0' | t | json }}, "view": {{ 'ba.view_verification' | t | json }}}, "e": [
{%- for cx_ba in cx_bas -%}
{%- unless forloop.first -%},{%- endunless -%}
{"x": 1
{%- if cx_ba.before_image.value -%}, "b": {{ cx_ba.before_image.value | image_url: width: 900 | json }}, "b2": {{ cx_ba.before_image.value | image_url: width: 1800 | json }}{%- endif -%}
{%- if cx_ba.after_image.value -%}, "a": {{ cx_ba.after_image.value | image_url: width: 900 | json }}, "a2": {{ cx_ba.after_image.value | image_url: width: 1800 | json }}{%- endif -%}
{%- if cx_ba.before_date.value -%}, "bd": {{ cx_ba.before_date.value | date: format: 'abbreviated_date' | json }}{%- endif -%}
{%- if cx_ba.weeks.value != blank -%}, "wn": {{ 'ba.week_n' | t: weeks: cx_ba.weeks.value | json }}{%- endif -%}
{%- if cx_ba.after_date.value -%}, "ad": {{ cx_ba.after_date.value | date: format: 'abbreviated_date' | json }}{%- endif -%}
{%- if cx_ba.imaging.value != blank and cx_ba.clinic.value != blank -%}, "cap": {{ 'ba.captured' | t: imaging: cx_ba.imaging.value, clinic: cx_ba.clinic.value | json }}{%- endif -%}
{%- if cx_ba.verifier_name.value != blank -%}
{%- if cx_ba.verifier_license.value != blank -%}, "vb": {{ 'ba.verified_by' | t: name: cx_ba.verifier_name.value, license: cx_ba.verifier_license.value | json }}{%- else -%}, "vb": {{ cx_ba.verifier_name.value | json }}{%- endif -%}
{%- if cx_ba.statement.value != blank -%}, "st": {{ cx_ba.statement.value | json }}{%- endif -%}
{%- if cx_ba.verification_url.value != blank -%}, "vu": {{ cx_ba.verification_url.value | json }}{%- endif -%}
{%- endif -%}}
{%- endfor -%}
]}
</script>
{%- endif -%}
{%- if show_batch or cx_draft_batch -%}
<script type="application/json" id="cx-batch-config">
{"live": {{ show_batch }}, "i": {{ cx_batch.intro.value | json }}, "ing": [
{%- for cx_ing in cx_batch.ingredients.value -%}
{%- unless forloop.first -%},{%- endunless -%}
{"n": {{ cx_ing.name.value | json }}, "note": {{ cx_ing.note.value | json }}, "c": {{ cx_ing.concentration.value | json }}, "f": {{ cx_ing.form.value | json }}}
{%- endfor -%}
], "coa": [
{%- for cx_coa in cx_batch.certificates.value -%}
{%- unless forloop.first -%},{%- endunless -%}
{%- liquid
assign cx_coa_url = cx_coa.document_url.value
if cx_coa_url == blank
assign cx_coa_url = cx_coa.document.value.url
endif
-%}
{"b": {{ 'batch.batch_no' | t: batch: cx_coa.batch.value | json }}
{%- if cx_coa.issued.value -%}, "d": {{ cx_coa.issued.value | date: format: 'abbreviated_date' | json }}{%- endif -%}
{%- if cx_coa.lab.value != blank -%}, "l": {{ 'batch.tested_by' | t: lab: cx_coa.lab.value | json }}{%- endif -%}
{%- if cx_coa_url != blank -%}, "u": {{ cx_coa_url | json }}{%- endif -%}}
{%- endfor -%}
], "str": {"eyebrow": {{ 'batch.eyebrow' | t | json }}, "title": {{ 'batch.title' | t | json }}, "ci": {{ 'batch.col_ingredient' | t | json }}, "cc": {{ 'batch.col_concentration' | t | json }}, "cf": {{ 'batch.col_form' | t | json }}, "coaTitle": {{ 'batch.coa_title' | t | json }}, "dl": {{ 'batch.download' | t | json }}, "hon": {{ 'batch.honesty' | t | json }}}}
</script>
{%- endif -%}
{%- if show_bottle or cx_draft_bottle -%}
{%- liquid
assign bottle_title = block.settings.bottle_title_override
if bottle_title == blank
assign bottle_title = 'bottle.title' | t
endif
assign cx_container_key = 'jar'
case cfg.emptyBottleGuarantee.container
when 'bottle', 'jar', 'tube', 'pump', 'product'
assign cx_container_key = cfg.emptyBottleGuarantee.container
endcase
case cx_pdp_flags.container
when 'bottle', 'jar', 'tube', 'pump', 'product'
assign cx_container_key = cx_pdp_flags.container
endcase
assign cx_container_tkey = 'bottle.container_' | append: cx_container_key
assign cx_container_word = cx_container_tkey | t
-%}
{%- assign cx_days_label = 'bottle.days_count' | t: count: bottle_days -%}
<script type="application/json" id="cx-bottle-config">
{"live": {{ show_bottle }}, "title": {{ bottle_title | json }}, "body": {{ 'bottle.body' | t: days: cx_days_label, container: cx_container_word | json }}, "p1": {{ 'bottle.point_1' | t: container: cx_container_word | json }}, "p2": {{ 'bottle.point_2' | t | json }}, "p3": {{ 'bottle.point_3' | t | json }}, "check": {{ 'guarantee_check.button' | t | json }}, "gc": {"close": {{ 'a11y.close' | t | json }}, "title": {{ 'guarantee_check.title' | t | json }}, "mech": {{ 'guarantee_check.mechanics_title' | t | json }}, "trust": {{ 'guarantee_check.trust_title' | t | json }}, "foot": {{ 'guarantee_check.footnote' | t | json }}, "facts": [{{ block.settings.guarantee_fact_1 | json }}, {{ block.settings.guarantee_fact_2 | json }}, {{ block.settings.guarantee_fact_3 | json }}, {{ block.settings.guarantee_fact_4 | json }}]}}
</script>
{%- endif -%}
<script src="{{ 'cellexia-pdp.js' | asset_url }}" defer></script>
{%- endif -%}
{%- endif -%}
{% schema %}
{"name":"Cellexia PDP booster","target":"body","settings":[{"type":"checkbox","id":"show_badges","label":"Show trust badges on product pages","default":true},{"type":"checkbox","id":"show_guarantee","label":"Show guarantee on product pages","default":true},{"type":"checkbox","id":"show_trustpilot","label":"Show Trustpilot strip on product pages","default":true},{"type":"checkbox","id":"show_nudge","label":"Show subscription nudge on product pages","default":true},{"type":"header","content":"Trust boosters (proof stack)"},{"type":"select","id":"proof_placement","label":"Placement","options":[{"value":"above_tabs","label":"Above the product tabs"},{"value":"below_tabs","label":"Below the product tabs"}],"default":"above_tabs"},{"type":"checkbox","id":"show_derm_survey","label":"Show dermatologist survey","default":true},{"type":"checkbox","id":"show_clinical_study","label":"Show clinical study","default":true},{"type":"checkbox","id":"show_before_after","label":"Show verified before/after","default":true},{"type":"checkbox","id":"show_batch","label":"Show batch transparency","default":true},{"type":"checkbox","id":"show_bottle","label":"Show empty bottle guarantee","default":true},{"type":"text","id":"bottle_title_override","label":"Guarantee title override","info":"Leave blank to use the translated default."},{"type":"header","content":"Guarantee check window"},{"type":"paragraph","content":"Company facts shown under \"Why you can count on it\" in the guarantee-check window. Enter only your own verifiable company facts (e.g. registration number, years in operation). Blank facts are hidden; all four blank hides the section. Translatable via Translate & Adapt."},{"type":"text","id":"guarantee_fact_1","label":"Company fact 1"},{"type":"text","id":"guarantee_fact_2","label":"Company fact 2"},{"type":"text","id":"guarantee_fact_3","label":"Company fact 3"},{"type":"text","id":"guarantee_fact_4","label":"Company fact 4"}]}
{% endschema %}
