{%- liquid
assign cfg = app.metafields.cellexia.config.value
assign cx_market = localization.market.handle | default: ''
assign cx_on = false
if cfg.beforeAfter.enabled == true
assign cx_scope = cfg.marketScopes.verified_before_after
if cx_scope.mode != 'selected' or cx_scope.markets contains cx_market
assign cx_on = true
endif
endif
assign cx_ctx = 'brand'
assign cx_pid = 0
assign cx_ok = true
if request.page_type == 'product'
assign cx_ctx = 'product'
assign cx_pid = product.id
if product.metafields.cellexia.pdp_flags.value.verified_before_after == false
assign cx_ok = false
assign cx_on = false
endif
endif
assign cx_draft = false
if cfg.preview.armed == true and cx_ok
if cfg.preview.draftFlags.verified_before_after == true or cfg.beforeAfter.enabled == true
assign cx_draft = true
endif
endif
-%}
{%- if cx_on or cx_draft -%}
{{ 'cellexia-booster.css' | asset_url | stylesheet_tag }}
<script type="application/json" id="cx-results-config" data-cx-market="{{ cx_market | escape }}">
{"live":{{cx_on}}{% if cfg.beforeAfter.density == "ultra" %}, "cm": 2{% elsif cfg.beforeAfter.density == "compact" %}, "cm": 1{% endif %},"ctx":{{cx_ctx|json}},"pid":{{cx_pid}},"str":{"bv":{{'results.banner_verified'|t:count:'@@N@@'|json}},"ba":{{'results.banner_all'|t:count:'@@N@@'|json}},"fc":{{'results.filter_concern'|t|json}},"fa":{{'results.filter_age'|t|json}},"fs":{{'results.filter_skin'|t|json}},"fd":{{'results.filter_duration'|t|json}},"sd":{{'results.skin_dry'|t|json}},"so":{{'results.skin_oily'|t|json}},"sc":{{'results.skin_combination'|t|json}},"ss":{{'results.skin_sensitive'|t|json}},"sn":{{'results.skin_normal'|t|json}},"d1":{{'results.duration_lt8'|t|json}},"d2":{{'results.duration_8to12'|t|json}},"d3":{{'results.duration_gt12'|t|json}},"ay":{{'results.age_years'|t:range:'@@R@@'|json}},"vb":{{'results.verified_badge'|t|json}},"lb":{{'results.lab_badge'|t|json}},"vid":{{'results.video_badge'|t|json}},"wk":{{'results.weeks_of_use'|t|json}},"bef":{{'results.before'|t|json}},"aft":{{'results.after'|t|json}},"more":{{'results.show_more'|t|json}},"empty":{{'results.empty'|t|json}},"close":{{'results.close'|t|json}},"clear":{{'results.clear_filters'|t|json}}}}
</script>
<div data-cx-mount="results" {{ block.shopify_attributes }}></div>
<script src="{{ 'cellexia-proof.js' | asset_url }}" defer></script>
{%- endif -%}
{% schema %}
{"name":"Cellexia results gallery","target":"section","settings":[]}
{% endschema %}
