{%- liquid
assign cfg = app.metafields.cellexia.config.value
assign cx_market = localization.market.handle | default: ''
assign cx_on = false
if cfg.dermEndorsements.enabled == true
assign cx_scope = cfg.marketScopes.derm_endorsements
if cx_scope.mode != 'selected' or cx_scope.markets contains cx_market
assign cx_on = true
endif
endif
assign cx_ctx = 'brand'
assign cx_pid = 0
assign cx_ok = true
if request.page_type == 'product'
assign cx_ctx = 'product'
assign cx_pid = product.id
if product.metafields.cellexia.pdp_flags.value.derm_endorsements == false
assign cx_ok = false
assign cx_on = false
endif
endif
assign cx_draft = false
if cfg.preview.armed == true and cx_ok
if cfg.preview.draftFlags.derm_endorsements == true or cfg.dermEndorsements.enabled == true
assign cx_draft = true
endif
endif
-%}
{%- if cx_on or cx_draft -%}
{{ 'cellexia-booster.css' | asset_url | stylesheet_tag }}
<script type="application/json" id="cx-endo-config" data-cx-market="{{ cx_market | escape }}">
{"live":{{cx_on}}{% if cfg.dermEndorsements.density == "ultra" %}, "cm": 2{% elsif cfg.dermEndorsements.density == "compact" %}, "cm": 1{% endif %},"ctx":{{cx_ctx|json}},"pid":{{cx_pid}},"str":{"eyebrow":{{'endo.eyebrow'|t|json}},"one":{{'endo.count_headline'|t:count:1,n:'@@N@@'|json}},"other":{{'endo.count_headline'|t:count:2,n:'@@N@@'|json}},"shown":{{'endo.shown_of'|t|json}},"more":{{'endo.show_more'|t|json}},"read":{{'endo.read_full'|t|json}}}}
</script>
<div data-cx-mount="endorsements" {{ block.shopify_attributes }}></div>
<script src="{{ 'cellexia-proof.js' | asset_url }}" defer></script>
{%- endif -%}
{% schema %}
{"name":"Cellexia endorsement wall","target":"section","settings":[]}
{% endschema %}
