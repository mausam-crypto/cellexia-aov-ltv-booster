// PRODUCTION (Postgres) twin of schema.prisma — generated for deploys.
//
// schema.prisma is the DEV schema (SQLite, file:dev.sqlite) and stays the
// source of truth. This file is IDENTICAL except for the datasource block:
// provider "postgresql" + url env("DATABASE_URL"). Use it on Postgres hosts
// instead of hand-patching schema.prisma:
//
//   npx prisma generate --schema prisma/schema.postgres.prisma
//   npx prisma db push  --schema prisma/schema.postgres.prisma
//
// (db push, NOT migrate deploy — the bundled migrations are SQLite-dialect.)
// The validation harness diffs this file against schema.prisma modulo the
// datasource block, so the two can never drift.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

// One row per shop. `data` holds the full BoosterSettings JSON blob
// (see app/models/settings.server.ts for the canonical shape). The same
// JSON is mirrored to metafields so the theme extension (Liquid) and the
// checkout UI extensions can read it without an API round-trip.
model ShopSettings {
  id        Int      @id @default(autoincrement())
  shop      String   @unique
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Lightweight event store for the analytics dashboard.
// type: impression | click | add_to_cart | upgrade | subscribe | protect | conversion
// feature: cart_upsell | checkout_upsell | protection | trust_badges | ...
model Event {
  id        Int      @id @default(autoincrement())
  shop      String
  feature   String
  type      String
  quantity  Int?
  revenue   Float?
  currency  String?
  market    String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([shop, feature, type, createdAt])
  @@index([shop, market, createdAt])
}

// Rolled-up order stats from the orders/paid webhook, used to report AOV
// and feature attach rates over time without storing full order payloads.
model OrderStat {
  id                 Int      @id @default(autoincrement())
  shop               String
  orderId            String   @unique
  totalPrice         Float
  currency           String
  lineCount          Int
  unitCount          Int
  hasSubscription    Boolean  @default(false)
  hasProtection      Boolean  @default(false)
  upsellAttributed   Boolean  @default(false)
  market             String?
  countryCode        String?
  processedAt        DateTime
  createdAt          DateTime @default(now())
  // v14 rewards: the KIT set-savings code redeemed on the order ("" = none)
  // and the number of free-gift lines (`_cellexia_gift` line property).
  kitCode            String   @default("")
  giftLines          Int      @default(0)

  @@index([shop, processedAt])
  @@index([shop, market, processedAt])
}

// v14 rewards (docs/SPEC-v14-rewards.md §3): per-shop state of the Discount
// Function nodes + gift stock. `nodes` json: {kit:{KIT2:"gid://shopify/
// DiscountCodeNode/..",...}, gift:"gid://shopify/DiscountAutomaticNode/..",
// ship:"gid://…", units:{<variantId>:2,...}, vp:{<variantId>:<productId>},
// prot:"<productId>"} — units/vp/prot are refreshed by buildUnitMap at
// Connect / Rewards-page save so the metafield sync never calls the API.
// `giftStock` json: {t, byMarket:{<market>:{<variantId>:{avail, paused}}}}.
model RewardsState {
  shop        String   @id
  functionId  String   @default("")
  nodes       String   @default("{}")
  giftStock   String   @default("{}")
  updatedAt   DateTime @updatedAt
}

// Machine-translation config (v5.2). The API key is SERVER-ONLY: it lives in
// this table and must never enter BoosterSettings (that blob is mirrored to
// storefront-readable metafields).
model TranslationConfig {
  id         Int      @id @default(autoincrement())
  shop       String   @unique
  provider   String   @default("deepl")
  apiKey     String   @default("")
  autoOnSave Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Preview system state (SPEC v4). The raw token lives server-side only (this
// DB + the checkout-only shop metafield) — never in page-visible Liquid
// config. draftFlags: JSON Record<FeatureKey, boolean>.
model PreviewState {
  id              Int       @id @default(autoincrement())
  shop            String    @unique
  token           String
  armed           Boolean   @default(false)
  armedAt         DateTime?
  draftFlags      String    @default("{}")
  // v5.8: non-boolean draft options for preview sessions (JSON, tokenless —
  // it is mirrored into the page-visible armed metafield payload). Currently
  // { dermSurveyFormat?: string }.
  draftConfig     String    @default("{}")
  simulatedMarket String?
  productHandle   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// v8 proof library (docs/SPEC-v8-proof-library.md §1). Hundreds/thousands of
// entries ride these tables + the /apps/cellexia/proof app-proxy JSON endpoint
// instead of Liquid JSON islands (byte budget) or metaobject list references
// (caps). productGids: JSON string[]; [] = brand-level entry. Postgres deploys
// apply this via `prisma db push` (see UPDATE.md v8 notes).
// ---------------------------------------------------------------------------

model PressItem {
  id          String   @id @default(cuid())
  shop        String
  status      String   @default("approved") // approved | hidden
  featured    Boolean  @default(false)
  sortWeight  Int      @default(0)
  publication String                        // e.g. "Vogue"
  logoUrl     String?                       // Shopify Files CDN url
  quote       String                        // the large quote
  articleUrl  String?
  productGids String   @default("[]")       // JSON string[]; [] = brand-level
  // JSON string[] of market handles; [] = every market. v8.1: each market
  // can carry its own publications (a French visitor sees the French press).
  marketHandles String @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shop, status, featured, sortWeight])
}

model DermEndorsement {
  id          String   @id @default(cuid())
  shop        String
  status      String   @default("approved")
  featured    Boolean  @default(false)
  sortWeight  Int      @default(0)
  name        String                        // "Dr. Anna Weiss"
  credentials String?                       // "MD, Board-certified dermatologist"
  country     String?                       // ISO2
  quote       String
  imageUrl    String?                       // optional portrait
  productGids String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shop, status, featured, sortWeight])
}

model CustomerResult {
  id            String   @id @default(cuid())
  shop          String
  status        String   @default("pending") // pending | approved | hidden
  featured      Boolean  @default(false)
  sortWeight    Int      @default(0)
  source        String   @default("customer") // lab | customer
  verified      Boolean  @default(false)      // verified purchase
  beforeUrl     String?
  afterUrl      String?
  ageRange      String?  // "18-24" | "25-34" | "35-44" | "45-54" | "55-64" | "65+"
  skinType      String?  // "dry" | "oily" | "combination" | "sensitive" | "normal"
  concern       String?  // free-slug, e.g. "wrinkles", "firmness" (admin tags)
  durationWeeks Int?
  country       String?  // ISO2
  testimonial   String?
  videoUrl      String?
  productGids   String   @default("[]")
  // Source cellexia_before_after metaobject GID when this row was created by
  // the legacy import — the unique constraint makes the import exactly-once.
  legacyGid     String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([shop, status, featured, sortWeight])
  @@index([shop, status, concern])
}

// v8.11: machine/manual translations for proof-library entry TEXT (press
// quotes, endorsement quotes/credentials, result testimonials). Source text
// lives on the entry rows (always the fallback); one row here per
// (entry, locale, field). sourceDigest = sha256 of the source at
// translation time — a changed source outdates the row (re-translated on
// the next run); manual rows are NEVER overwritten by auto-translation.
// Names, publications, URLs and country codes are never translated (the
// TRANSLATABLE_PROOF_FIELDS allowlist in proof-translation.server.ts).
model ProofTranslation {
  id           String   @id @default(cuid())
  shop         String
  resourceType String   // press | endorsement | result
  resourceId   String
  locale       String   // normalized lowercase shop locale ("fr", "pt-pt")
  field        String   // quote | credentials | testimonial
  value        String
  sourceDigest String
  manual       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([shop, resourceType, resourceId, locale, field])
  @@index([shop, resourceType, resourceId])
}

// A sequential (never A/B) experiment: flip features for one market, then
// compare an equal-length window against the immediately-preceding baseline.
// See docs/SPEC-v2-markets-experiments.md.
model Experiment {
  id           Int       @id @default(autoincrement())
  shop         String
  name         String
  market       String    // market handle, or "all"
  flips        String    // JSON: [{ key, from, to }]
  revertState  String    // JSON FlagsSnapshot taken at start
  settingsHash String?   // hash of flags+scopes right after start (drift detection)
  baselineDays Int
  baselineFrom DateTime
  baselineTo   DateTime
  startedAt    DateTime
  endsAt       DateTime
  status       String    // running | concluding (transient claim) | completed | stopped
  concludedAt  DateTime?
  outcome      String?   // kept | rolled_back
  warningJson  String?
  reportJson   String?
  startSyncErrors String? // JSON string[] — metafield sync errors from start, cleared on successful retry
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([shop, status])
}

// v10 US state module (docs/SPEC-v10-us-state-delivery.md §6): compiled
// IP→US-state range table behind the /apps/cellexia/geo proxy endpoint.
// Built by streaming the self-hosted DB-IP City Lite CSV (CC BY 4.0,
// monthly refresh) — SOURCE data only, never visitor data (visitor IPs are
// never stored or logged anywhere). dataV4/dataV6 hold gzipped fixed-size
// sorted records; stateIdx bytes index the US_STATE_CODES array in
// app/services/geo.server.ts (part of the stored format — never reorder).
// Postgres deploys apply this via `prisma db push` (see UPDATE.md v10 notes).
model GeoStateDb {
  id        Int       @id @default(autoincrement())
  shop      String    @unique
  status    String    @default("empty")  // empty | building | ready | error
  source    String    @default("")       // "dbip-city-lite-YYYY-MM"
  error     String    @default("")
  rangesV4  Int       @default(0)
  rangesV6  Int       @default(0)
  dataV4    Bytes?    // gzip( concat per range: start BE u32, end BE u32, stateIdx u8 )
  dataV6    Bytes?    // gzip( concat per range: start 16B BE, end 16B BE, stateIdx u8 )
  builtAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
